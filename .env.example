# Names only. Copy to .env and fill locally; never commit real values (CLAUDE.md §3).
NODE_ENV=development
PROCESS_ROLE=api
PORT=4000
PUBLIC_BASE_URL=http://localhost:4000
ADMIN_WEB_ORIGIN=http://localhost:3000
COOKIE_DOMAIN=
MONGODB_URI=mongodb://localhost:27017/?replicaSet=rs0
MONGODB_DB_NAME=field_ops
# EdDSA key pair (PEM, base64). Leave empty in development: an ephemeral pair is generated at boot.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_KEY_ID=dev
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_DAYS_APP=30
REFRESH_TOKEN_TTL_HOURS_WEB=12
# mock = in-process fake ERP · live = HTTP (Laravel, or `pnpm mock:erp`) · record_only = store, do not post
ERP_MODE=mock
ERP_BASE_URL=
ERP_API_TOKEN=
ERP_API_TOKEN_NEXT=
ERP_TIMEOUT_MS=10000
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET_MEDIA=fos-media
S3_BUCKET_EXPORTS=fos-exports
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=
SENTRY_DSN=
LOG_LEVEL=info
TRUST_PROXY=false
# Local tooling only
SEED_PASSWORD=
MOCK_ERP_PORT=4100
MOCK_ERP_HOST=127.0.0.1
MOCK_ERP_TOKEN=
