# Names only. Copy to .env and fill locally; never commit real values (CLAUDE.md §3).
# This file is public on GitHub. Real values live only in your local .env and in the host's
# environment settings (Vercel, Railway).
NODE_ENV=development
PROCESS_ROLE=api
PORT=4000
PUBLIC_BASE_URL=http://localhost:4000
ADMIN_WEB_ORIGIN=http://localhost:3000
# Empty on localhost. On a real host: the parent domain the API and admin-web share, for example .example.com
COOKIE_DOMAIN=
# true behind a proxy (Vercel, Railway)
TRUST_PROXY=false
# Local replica set. Atlas: mongodb+srv://<user>:<password>@<cluster-host>/<db>?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/?replicaSet=rs0
MONGODB_DB_NAME=field_ops
# EdDSA key pair (PEM, base64) from `pnpm keys:jwt`. Leave empty in development: an ephemeral pair is
# generated at boot. Required on Vercel and in production.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_KEY_ID=dev
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_DAYS_APP=30
REFRESH_TOKEN_TTL_HOURS_WEB=12
# mock = in-process fake ERP · live = HTTP (Laravel, or `pnpm mock:erp`) · record_only = store, do not post
ERP_MODE=mock
# live / record_only: https://<erp-host>/api/field/v1 and the token printed by `php artisan field-api:setup`
ERP_BASE_URL=
ERP_API_TOKEN=
ERP_API_TOKEN_NEXT=
ERP_TIMEOUT_MS=10000
# Cloudflare R2: https://<account-id>.r2.cloudflarestorage.com (empty = in memory in development, MongoDB on Vercel)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET_MEDIA=fos-media
S3_BUCKET_EXPORTS=fos-exports
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# s3 | db (files in MongoDB, for hosts without S3) | memory. Empty = automatic (db on Vercel without S3)
STORAGE_DRIVER=
# Cloudinary (ADR-050): photos are copied to this account after upload and removed from the store above.
# All three of name, key and secret must be set to turn it on; empty = photos stay in the store above.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional folder (public id prefix) in Cloudinary; default fos
CLOUDINARY_FOLDER=
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=
SENTRY_DSN=
LOG_LEVEL=info
# Local tooling only
SEED_PASSWORD=
MOCK_ERP_PORT=4100
MOCK_ERP_HOST=127.0.0.1
MOCK_ERP_TOKEN=
# Vercel test deployment only: bearer secret for /api/cron (at least 16 random characters)
CRON_SECRET=
