{
  "name": "field-api",
  "version": "0.1.0",
  "description": "Howlader Field Operations System backend (Fastify + MongoDB); owner of the API contract",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "dev:worker": "PROCESS_ROLE=worker tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/main.js",
    "start:worker": "PROCESS_ROLE=worker node dist/src/main.js",
    "typecheck": "tsc --noEmit -p .",
    "lint": "eslint . && prettier --check \"scripts/**/*.ts\" \"mock-erp/**/*.ts\" && depcruise src --config .dependency-cruiser.cjs",
    "lint:boundaries": "depcruise src --config .dependency-cruiser.cjs",
    "format": "prettier --write \"scripts/**/*.ts\" \"mock-erp/**/*.ts\"",
    "test": "vitest run",
    "test:unit": "vitest run src",
    "test:integration": "vitest run test/integration",
    "test:contract": "vitest run test/contract",
    "test:coverage": "vitest run --coverage",
    "check:permissions": "tsx scripts/check-permissions.ts",
    "check:changelog": "tsx scripts/check-changelog.ts",
    "openapi:lint": "tsx scripts/openapi-lint.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "seed:dev": "tsx scripts/seed-dev.ts",
    "mock:erp": "tsx mock-erp/server.ts",
    "new:module": "tsx scripts/new-module.ts",
    "smoke": "tsx scripts/smoke.ts"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.28.0",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1169.0",
    "@aws-sdk/s3-request-presigner": "^3.1169.0",
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.4.3",
    "@fastify/rate-limit": "^11.2.2",
    "@node-rs/argon2": "^2.2.2",
    "fastify": "^5.12.8",
    "jose": "^6.2.17",
    "luxon": "^3.7.2",
    "mongoose": "^8.24.9",
    "pino": "^10.4.0",
    "uuid": "^14.0.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/luxon": "^3.7.6",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.1.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "dependency-cruiser": "^18.7.2",
    "eslint": "^9.39.5",
    "mongodb-memory-server": "^11.3.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0",
    "yaml": "^2.9.1"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  }
}
