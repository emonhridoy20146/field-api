{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm build",
  "outputDirectory": "public",
  "regions": ["bom1"],
  "functions": {
    "api/index.js": { "maxDuration": 60, "includeFiles": "assets/fonts/**" },
    "api/cron.js": { "maxDuration": 60, "includeFiles": "assets/fonts/**" }
  },
  "rewrites": [{ "source": "/((?!api/cron).*)", "destination": "/api/index" }]
}
